{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "site"],
      "port": 8765
    },
    {
      "name": "ensayo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "ensayo.api:app", "--port", "8040"],
      "port": 8040
    },
    {
      "name": "shield-real",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ENSAYO_REAL=1", "uv", "run", "uvicorn", "ensayo.api:app", "--port", "8041"],
      "port": 8041
    }
  ]
}
